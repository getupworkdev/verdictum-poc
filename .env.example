# Supabase project (EU region)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: rate limiting, seeding, and the isolation demo's lookup of the other firm's case id
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Set a low monthly spend limit for this key in the Anthropic console.
ANTHROPIC_API_KEY=

# Password for the demo gate in front of the whole app
DEMO_PASSWORD=
# Password of the two fictional demo logins (shown on the login page)
NEXT_PUBLIC_DEMO_USER_PASSWORD=
